#!/usr/bin/env python3
"""Dispatch the standard demo goal while keeping the simulator alive."""

from argparse import ArgumentParser
import json
from math import ceil, cos, sin
from pathlib import Path

from geometry_msgs.msg import PoseStamped, Twist
from lifecycle_msgs.msg import State
from lifecycle_msgs.srv import GetState
from nav2_msgs.action import FollowPath, NavigateToPose
from nav_msgs.msg import Path as NavPath
import rclpy
from rclpy.action import ActionClient
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from tf2_ros import Buffer, TransformListener
import yaml


class DemoGoal(Node):
    """Send one goal when the simulator and Nav2 are ready."""

    def __init__(self, scene, data, start_file):
        super().__init__('mydwa_demo_goal')
        self.scene = scene
        self.data = data
        self.start_file = start_file
        self.static = scene == 'S02'
        self.client = ActionClient(
            self, NavigateToPose if self.static else FollowPath,
            '/navigate_to_pose' if self.static else '/follow_path')
        server = '/bt_navigator' if self.static else '/controller_server'
        self.lifecycle = self.create_client(GetState, f'{server}/get_state')
        self.state_request = None
        self.tf = Buffer()
        self.tf_listener = TransformListener(self.tf, self)
        self.motion_subscription = None
        self.ready_timer = self.create_timer(.10, self.try_goal)

    def try_goal(self):
        """Wait for user confirmation and use the scenario motion origin."""
        if self.start_file is not None and not self.start_file.is_file():
            return
        frame = 'map' if self.static else 'odom'
        if not self.client.server_is_ready() or not self.tf.can_transform(
                frame, 'base_link', rclpy.time.Time()):
            return
        if not self.lifecycle.service_is_ready():
            return
        if self.state_request is None:
            self.state_request = self.lifecycle.call_async(GetState.Request())
            return
        if not self.state_request.done():
            return
        state = self.state_request.result().current_state
        self.state_request = None
        if state.id != State.PRIMARY_STATE_ACTIVE:
            return
        if self.static:
            x, y, yaw = yaml.safe_load(self.data.read_text())['scenarios'][self.scene]['goal']
            pose = self.pose(frame, x, y)
            pose.pose.orientation.z, pose.pose.orientation.w = sin(yaw / 2), cos(yaw / 2)
            goal = NavigateToPose.Goal(pose=pose)
        else:
            if self.motion_subscription is None:
                # The actor script waits for this subscriber before starting its timeline.
                self.motion_subscription = self.create_subscription(
                    Twist, '/my_dwa/demo/motion_cmd', lambda _: None, 1)
            timeline = self.data.with_name('timeline.jsonl')
            if not timeline.is_file() or 'Scenario started' not in timeline.read_text():
                return
            trial = json.loads(self.data.read_text())
            distance = trial['goal'] - trial['start']
            count = max(1, ceil(distance / .05))
            poses = [self.pose(frame, distance * i / count, 0.) for i in range(count + 1)]
            path = NavPath(header=poses[0].header, poses=poses)
            goal = FollowPath.Goal(path=path, controller_id='FollowPath',
                                   goal_checker_id='general_goal_checker')
        self.ready_timer.cancel()
        self.get_logger().info(f'Sending {self.scene} navigation goal')
        self.client.send_goal_async(goal).add_done_callback(self.goal_response)

    def pose(self, frame, x, y):
        """Create a stamped pose in the navigation frame."""
        pose = PoseStamped()
        pose.header.frame_id = frame
        pose.header.stamp = self.get_clock().now().to_msg()
        pose.pose.position.x, pose.pose.position.y = float(x), float(y)
        pose.pose.orientation.w = 1.
        return pose

    def goal_response(self, future):
        """Report the result without closing the demo windows."""
        handle = future.result()
        if handle.accepted:
            handle.get_result_async().add_done_callback(
                lambda result: self.get_logger().info(
                    f'Navigation finished (status {result.result().status}). Ctrl+C to close.'))
        else:
            self.get_logger().info('Nav2 is not active yet. Waiting to send the goal again.')
            self.ready_timer.reset()


def main():
    """Run until the ROS launch service sends a shutdown signal."""
    args = ArgumentParser()
    args.add_argument('scene')
    args.add_argument('data', type=Path)
    args.add_argument('--start-file', type=Path)
    node_args, ros_args = args.parse_known_args()
    rclpy.init(args=ros_args)
    node = DemoGoal(node_args.scene, node_args.data, node_args.start_file)
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
