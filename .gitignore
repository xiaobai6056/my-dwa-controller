*.swp
# Keep the existing static benchmark ignored; expose the new dynamic module.
!/benchmark/
/benchmark/*
!/benchmark/test_dynamic.py
!/benchmark/dynamic/
!/benchmark/dynamic/**/*.md
!/benchmark/dynamic/*.md
!/benchmark/dynamic/evidence/*.log

